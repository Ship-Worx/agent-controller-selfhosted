{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeOnlyReviewedRuntimeAndEndpoint",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:InvokeAgentRuntime"
      ],
      "Resource": [
        "__OBSERVED_AGENT_RUNTIME_ARN__",
        "__OBSERVED_SELECTED_ENDPOINT_ARN__"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "__INSTALL_REGION__"
        }
      }
    }
  ]
}
