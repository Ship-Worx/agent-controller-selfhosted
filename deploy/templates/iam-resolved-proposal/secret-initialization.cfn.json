{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InitializeOnlySyntheticSecretVersions",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:PutSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        {
          "Ref": "AdminSecret"
        },
        {
          "Ref": "TlsSecret"
        }
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "__INSTALL_REGION__"
        }
      }
    },
    {
      "Sid": "EncryptOnlySyntheticSecretsThroughSecretsManager",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": {
        "Fn::GetAtt": [
          "PilotKey",
          "Arn"
        ]
      },
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "__INSTALL_REGION__",
          "kms:ViaService": "secretsmanager.__INSTALL_REGION__.amazonaws.com",
          "kms:EncryptionContext:SecretARN": [
            {
              "Ref": "AdminSecret"
            },
            {
              "Ref": "TlsSecret"
            }
          ]
        }
      }
    }
  ]
}
