{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyPilotRuntimeMayAssumeWorkerRole",
      "Effect": "Allow",
      "Principal": {
        "Service": "bedrock-agentcore.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "__INSTALL_ACCOUNT__"
        },
        "ArnLike": {
          "aws:SourceArn": "arn:aws:bedrock-agentcore:__INSTALL_REGION__:__INSTALL_ACCOUNT__:runtime/agent_controller_pilot-*"
        }
      }
    }
  ]
}
