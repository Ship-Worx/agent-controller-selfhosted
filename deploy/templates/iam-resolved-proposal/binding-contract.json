    "worker-identity-steady-state.json",
    "worker-s3-egress.json",
    "worker-trust-bootstrap.json",
    "worker-trust-steady-state.json"
  ],
  "binding_patterns": {
    "PilotVpc": "vpc-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "PilotSubnet": "subnet-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "PilotRouteTable": "rtb-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "Controller": "i-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "ControllerDataVolume": "vol-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "PreparedControllerImageId": "ami-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "WorkerSecurityGroup": "sg-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "ControllerSecurityGroup": "sg-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "WorkerEndpointSecurityGroup": "sg-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "ControllerEndpointSecurityGroup": "sg-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "PrivateHostedZone": "Z[A-Z0-9]{1,31}",
    "PilotKey.Arn": "arn:aws:kms:__INSTALL_REGION__:__INSTALL_ACCOUNT__:key/[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}",
    "AdminSecret": "arn:aws:secretsmanager:__INSTALL_REGION__:__INSTALL_ACCOUNT__:secret:agent-controller/pilot/admin-[A-Za-z0-9]{6}",
    "TlsSecret": "arn:aws:secretsmanager:__INSTALL_REGION__:__INSTALL_ACCOUNT__:secret:agent-controller/pilot/tls-[A-Za-z0-9]{6}",
    "AgentRuntimeArn": "arn:aws:bedrock-agentcore:__INSTALL_REGION__:__INSTALL_ACCOUNT__:runtime/agent_controller_pilot-[A-Za-z0-9]{10}",
    "SelectedEndpointArn": "arn:aws:bedrock-agentcore:__INSTALL_REGION__:__INSTALL_ACCOUNT__:runtime/agent_controller_pilot-[A-Za-z0-9]{10}/runtime-endpoint/PILOT",
    "WorkerPlatformLogGroupArn": "arn:aws:logs:__INSTALL_REGION__:__INSTALL_ACCOUNT__:log-group:/aws/bedrock-agentcore/runtimes/agent_controller_pilot-[A-Za-z0-9]{10}-PILOT",
    "EcrApiEndpoint": "vpce-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "EcrDockerEndpoint": "vpce-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "LogsEndpoint": "vpce-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "SecretsManagerEndpoint": "vpce-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "SsmEndpoint": "vpce-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "SsmMessagesEndpoint": "vpce-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "S3GatewayEndpoint": "vpce-(?:[0-9a-f]{8}|[0-9a-f]{17})",
    "S3ManagedPrefixList": "pl-(?:[0-9a-f]{8}|[0-9a-f]{17})"
  },
  "constant_bindings": {
    "AWS::Partition": "aws",
    "AWS::AccountId": "__INSTALL_ACCOUNT__",
    "AWS::Region": "__INSTALL_REGION__",
    "ControllerRole.Arn": "arn:aws:iam::__INSTALL_ACCOUNT__:role/agent-controller-pilot-controller",
    "WorkerRole.Arn": "arn:aws:iam::__INSTALL_ACCOUNT__:role/agent-controller-pilot-worker",
    "WorkerRepository.Arn": "arn:aws:ecr:__INSTALL_REGION__:__INSTALL_ACCOUNT__:repository/agent-controller-worker",
    "ControllerLogGroup.Arn": "arn:aws:logs:__INSTALL_REGION__:__INSTALL_ACCOUNT__:log-group:/agent-controller/agent-controller-pilot/controller:*"
  },
  "markers": {
    "__OBSERVED_AGENT_RUNTIME_ARN__": "AgentRuntimeArn",
    "__OBSERVED_SELECTED_ENDPOINT_ARN__": "SelectedEndpointArn",
    "__OBSERVED_PLATFORM_LOG_GROUP_ARN_NO_SUFFIX__": "WorkerPlatformLogGroupArn",
    "__NEW_WORKER_SECURITY_GROUP_ID__": "WorkerSecurityGroup"
  },
  "operator_iam_variables": [
    "aws:userid"
  ],
  "required_project_tag": {
    "Project": "agent-controller"
  },
  "never_apply_automatically": true,
  "cleanup_endpoint_bindings": [
    "EcrApiEndpoint",
    "EcrDockerEndpoint",
    "LogsEndpoint",
    "SecretsManagerEndpoint",
    "SsmEndpoint",
    "SsmMessagesEndpoint",
    "S3GatewayEndpoint"
  ]
}
