{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeOnlyReviewedWorkerRuntime",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:InvokeAgentRuntime"
      ],
      "Resource": "arn:aws:bedrock-agentcore:__INSTALL_REGION__:__INSTALL_ACCOUNT__:runtime/__REQUIRED_WORKER_RUNTIME_ID__",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "__INSTALL_REGION__"
        }
      }
    }
  ]
}
