{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassOnlyControllerRoleToEc2",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::__INSTALL_ACCOUNT__:role/__REQUIRED_CONTROLLER_ROLE_PATH_AND_NAME__",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassOnlyWorkerRoleToAgentCore",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::__INSTALL_ACCOUNT__:role/__REQUIRED_WORKER_ROLE_PATH_AND_NAME__",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
        }
      }
    }
  ]
}
